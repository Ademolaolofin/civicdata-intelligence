{
  "name": "civicdata-explorer-v03-poc",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --ssr src/prerender.tsx --outDir .build/renderer && node .build/renderer/prerender.js",
    "check": "node check.mjs",
    "check:pilot": "vite build --ssr src/pilot.ts --outDir .build/pilot-test && node check-pilot.mjs"
  },
  "dependencies": { "react": "19.2.4", "react-dom": "19.2.4" },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
